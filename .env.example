# Copy this file to .env at the repository root. The API looks for .env in its working
# directory and then in the parent, so `cd server && go run ./cmd/api` and root-level scripts
# both find it. Variables already present in the environment always win over this file.
# Full reference: my-docs/DECISIONS.md D-43.
#
# Docker Compose (D-70) reads this file if it exists, honoring JWT_SECRET / APP_ENV /
# COOKIE_SECURE, but pins STORE, SQLITE_PATH and SAMPLE_DATA_PATH to their in-container values
# (the SQLite file lives on a named volume) — so `docker compose up --build` also works with no
# .env at all. See README "Option B — Docker Compose".

# API listen port.
PORT=3000

# development | test | production
# "test" lowers bcrypt cost, disables rate limiting and silences logs.
APP_ENV=development

# Secret for signing session JWTs. Must be >= 32 chars.
# The server refuses to boot with this placeholder value when APP_ENV=production.
JWT_SECRET=change-me-to-a-random-32+-char-string

# Set to "true" only when serving over HTTPS.
COOKIE_SECURE=false

# Persistence backend (D-66). "sqlite" (the default from Step 11) persists to SQLITE_PATH and
# seeds itself from SAMPLE_DATA_PATH only on first boot (empty database). "memory" loads
# SAMPLE_DATA_PATH fresh at every boot; writes then live only in process memory, so a restart
# resets the data — useful for local experimentation, not what ships.
STORE=sqlite

# Sample data file the memory store (always) and the sqlite store (first boot only) load,
# relative to server/ (D-67).
SAMPLE_DATA_PATH=./data/sample.json

# SQLite database file, relative to server/. Created on first boot; gitignored.
SQLITE_PATH=./data/twitter.db

# Lets `npm run seed` (go run ./cmd/seed) run under APP_ENV=production. Leave false; seeding
# production data is a deliberate, explicit action.
SEED_FORCE=false
