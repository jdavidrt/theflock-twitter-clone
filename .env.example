# PostgreSQL connection string used by the API.
# Docker Compose overrides host/port for the server container.
DATABASE_URL=postgresql://twitter:twitter@localhost:5433/twitter

# Secret for signing session JWTs. Must be >= 32 chars.
# The server refuses to boot with this placeholder value in production.
JWT_SECRET=change-me-to-a-random-32+-char-string

# API port.
PORT=3000

# development | test | production
# "test" lowers bcrypt cost and disables rate limiting; "production" is used in Docker.
NODE_ENV=development

# Set to "true" only when serving over HTTPS.
COOKIE_SECURE=false

# Consumed by the postgres image in docker-compose.yml, and used to build
# the server's DATABASE_URL inside the compose network.
POSTGRES_USER=twitter
POSTGRES_PASSWORD=twitter
POSTGRES_DB=twitter
